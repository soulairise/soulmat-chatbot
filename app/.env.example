# 네이버 커머스 API 인증 정보
# 발급처: https://apicenter.commerce.naver.com  →  애플리케이션 관리
#
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 에 있어 저장소에 올라가지 않습니다.
# client_secret 은 채팅창이나 GitHub 에 절대 붙여넣지 마세요.

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 본인 스토어만 조회할 때는 비워 두세요 (type=SELF 로 동작).
# 다른 판매자 리소스를 대행 조회할 때만 판매자 ID를 넣습니다 (type=SELLER).
NAVER_ACCOUNT_ID=
